{
  "build": {
    "frontendDist": "../MPW/dist",
    "devUrl": "http://127.0.0.1:5500"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "./icons/mpw_dmg_bg.png",
        "windowSize": {
          "height": 425,
          "width": 660
        },
        "applicationFolderPosition": {
          "x": 330,
          "y": 300
        },
        "appPosition": {
          "x": 330,
          "y": 70
        }
      }
    }
  },
  "productName": "My PIVX Wallet",
  "mainBinaryName": "my-pivx-wallet",
  "version": "0.1.0",
  "identifier": "org.mypivxwallet",
  "plugins": {},
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "My PIVX Wallet",
        "width": 800,
        "height": 600,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
